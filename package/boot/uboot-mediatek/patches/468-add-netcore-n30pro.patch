--- /dev/null
+++ b/defenvs/netcore_n30pro.env
@@ -0,0 +1,14 @@
+# N30 local r1. No environment persistence or automatic erase/restore.
+serverip=192.168.1.254
+ipaddr=192.168.1.1
+loadaddr=0x46000000
+bootconf=config-1
+bootfile_rec=n30pro-local-r1-initramfs.itb
+boot_recovery=if tftpboot $loadaddr $bootfile_rec; then if iminfo $loadaddr; then bootm $loadaddr#$bootconf; fi; fi
+boot_nand=if ubi part ubi; then if ubi read $loadaddr fit; then bootm $loadaddr#$bootconf; fi; fi
+bootcmd=bootmenu -1
+bootmenu_delay=-1
+bootmenu_default=0
+bootmenu_0=Boot installed OpenWrt=run boot_nand
+bootmenu_1=Load RAM recovery via TFTP (no automatic flash write)=run boot_recovery
+bootmenu_2=U-Boot console (no automatic restore)=echo Enter console
